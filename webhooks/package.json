{
  "name": "battle-rhythm-hooks",
  "private": true,
  "type": "module",
  "description": "GitHub webhook receiver for battle-rhythm: verifies signatures, dedupes deliveries, relays CI alerts to Discord.",
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --env sandbox",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "deploy:production": "wrangler deploy --env production",
    "probe": "node scripts/probe.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
